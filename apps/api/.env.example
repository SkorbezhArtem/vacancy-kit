# vacancy-kit api environment

# server
NODE_ENV=development
PORT=8000

# csv of allowed origins, or * for any
CORS_ORIGINS=*

# llm providers
# get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# get a free key at https://openrouter.ai/keys (free models)
OPENROUTER_API_KEY=

# gemini | openrouter | auto (default: auto)
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# free quota per anon-id per 24h
RATE_LIMIT_PER_DAY=3
